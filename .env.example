# Copy to .env before `docker compose up`. Generate secrets with: openssl rand -base64 48
POSTGRES_PASSWORD=sams
JWT_SECRET=change-me
QR_HMAC_SECRET=change-me-too
JWT_EXPIRES_IN=15m
APP_URL=http://localhost:5173
# The bundled setup serves plain http on localhost; put HTTPS in front and set this to true in production
COOKIE_SECURE=false
# Leave empty to print emails to the API log instead of sending them
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
