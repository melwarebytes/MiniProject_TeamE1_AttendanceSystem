PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://sams:sams@localhost:5432/sams_dev?schema=public
REDIS_URL=redis://localhost:6379

# Change both secrets outside local development (openssl rand -base64 48)
JWT_SECRET=change-me-dev-only-jwt-secret
JWT_EXPIRES_IN=15m
QR_HMAC_SECRET=change-me-dev-only-qr-secret

# Refresh cookie is Secure by default; set to false only when serving plain http on a non-localhost host
COOKIE_SECURE=true

# Leave SMTP_HOST empty to print emails to the server log instead of sending them
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SAMS Attendance System <no-reply@sams.pes.edu>"
UPLOAD_DIR=uploads
